<% layout("/layouts/boilerplate") -%>

<% if(items.length === 0){ %>
<center><h4 class=" text-center mt-4 mb-4  fw-bold text-dark"  >Your Cart is Empty</h4></center>
<% } %>
<h2 class="mb-4">My Cart</h2>

<div class="row">

<% items.forEach(item => { %>

<div class="col-lg-3 col-md-4 col-sm-6 col-12 mb-4">

<div class="card mb-4 shadow-sm border-0 rounded-4">

<img src="<%= item.image %>" class="card-img-top "
alt="cart-image" style="height:220px;object-fit:cover;">

<div class="card-body d-flex flex-column">

<h5><%= item.title %></h5>

<p>₹<%= item.price %></p>
<form action="/listings/mycart/<%= item._id %>?_method=DELETE" method="post">

<button class="btn btn-danger rounded-pill">Remove</button>
</form>

</div>
</div>
</div>

<% }) %>

</div>