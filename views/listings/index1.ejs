<% layout("/layouts/boilerplate") -%>

<script>
  const listing = <%- JSON.stringify(inddata) %>;
  const mapToken = "<%= mapToken %>";
</script>

<div class="container mt-4">

  <div class="row justify-content-center">

    <!-- LISTING SECTION -->

    <div class="col-lg-8 col-md-10 col-12">

      <h2 class="fw-bold mb-4 text-center">
        <%= inddata.title %>
      </h2>

      <div class="card listing-card shadow border-0 rounded-4 overflow-hidden">

        <img 
          src="<%= inddata.image.url %>" 
          class="card-img-top show-img"
          alt="Listing_image"
        >

        <div class="card-body p-4">

          <p class="card-text">
            <i>
              <%= inddata.owner ? inddata.owner.username : "No Owner" %>
            </i>
          </p>

          <p class="card-text">
            <%= inddata.description %>
          </p>

          <p class="card-text fw-bold">
            ₹ <%= inddata.price.toLocaleString("en-IN") %>
          </p>

          <p class="card-text">
            Country : <%= inddata.country %>
          </p>

          <form action="/listings/<%= inddata._id %>/cart" method="POST">

            <button class="btn btn-danger rounded-pill w-100">
              Add to Cart
            </button>

          </form>

        </div>

      </div>

      <!-- EDIT DELETE BUTTONS -->

      <% if(currUser && inddata && inddata.owner?._id && String(currUser._id)===String(inddata.owner._id)) { %>

      <div class="d-flex gap-2 flex-wrap mb-4 mt-3">

        <a 
          href="/listings/<%= inddata._id%>/edit"
          class="btn btn-dark rounded-pill"
        >
          Edit
        </a>

        <form 
          method="POST"
          action="/listings/<%= inddata._id %>/delete?_method=DELETE"
        >

          <button class="btn btn-danger rounded-pill">
            Delete
          </button>

        </form>

      </div>

      <% } %>

      <hr>

      <!-- REVIEW FORM -->

      <% if(currUser) { %>

      <div class="mb-4">

        <h4 class="mb-3">Leave a Review</h4>

        <form 
          action="/listings/<%= inddata._id %>/reviews"
          method="POST"
          novalidate
          class="needs-validation"
        >

          <div class="mb-3">

            <label class="form-label">
              Rating
            </label>

            <fieldset class="starability-slot">

  <input type="radio"
         id="first-rate1"
         name="review[rating]"
         value="1"
         checked />
  <label for="first-rate1" title="Terrible">
      1 star
  </label>

  <input type="radio"
         id="first-rate2"
         name="review[rating]"
         value="2" />
  <label for="first-rate2" title="Not good">
      2 stars
  </label>

  <input type="radio"
         id="first-rate3"
         name="review[rating]"
         value="3" />
  <label for="first-rate3" title="Average">
      3 stars
  </label>

  <input type="radio"
         id="first-rate4"
         name="review[rating]"
         value="4" />
  <label for="first-rate4" title="Very good">
      4 stars
  </label>

  <input type="radio"
         id="first-rate5"
         name="review[rating]"
         value="5" />
  <label for="first-rate5" title="Amazing">
      5 stars
  </label>

</fieldset>

          </div>

          <div class="mb-3">

            <label class="form-label">
              Comments
            </label>

            <textarea
              name="review[comment]"
              id="comment"
              rows="5"
              class="form-control"
              required
            ></textarea>

            <div class="invalid-feedback">
              Please write comment to add review
            </div>

          </div>

          <button class="btn btn-outline-dark rounded-pill">
            Submit
          </button>

        </form>

      </div>

      <% } %>

      <!-- REVIEWS -->

      <% if(inddata.reviews.length > 0) { %>

      <div class="row mt-4">

        <h4 class="mb-4">All Reviews</h4>

        <% for(list of inddata.reviews){ %>

        <div class="col-lg-6 col-md-6 col-12 mb-4">

          <div class="card h-100 shadow-sm border-0 rounded-4">

            <div class="card-body">

              <div class="card-title fw-bold mb-2">
                <%= inddata.owner ? inddata.owner.username : "No Owner" %>
              </div>

              <p class="card-text">
                <%= list.comment %>
              </p>

              <p 
                class="starability-result card-text"
                data-rating="<%= list.rating %>"
              ></p>

              <form 
                class="mt-3"
                method="POST"
                action="/listings/<%= inddata._id %>/reviews/<%=list._id %>?_method=DELETE"
              >

                <button class="btn btn-dark btn-sm rounded-pill">
                  Delete
                </button>

              </form>

            </div>

          </div>

        </div>

        <% } %>

      </div>

      <% } %>

    </div>

    <!-- MAP SECTION -->

    <div class="col-lg-10 col-md-11 col-12 mt-5 mb-5">

      <h3 class="mb-3 text-center">
        Where you will be
      </h3>

      <div id="map"></div>

    </div>

  </div>

</div>

<script src="/js/map.js"></script>