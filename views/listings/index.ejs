<style>
#filters{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:1rem;
}

.filter{
    text-align:center;
    margin-top:1.5rem;
    opacity:0.7;
}

.filter:hover{
    opacity:1;
    cursor:pointer;
}

.filter p{
    font-size:0.9rem;
    margin:0;
}

.tax-toggle{
    border:1px solid black;
    border-radius:1rem;
    height:3.5rem;
    padding:0 1rem;
    display:flex;
    align-items:center;
    margin-top:1.5rem;
    margin-left:auto;
    white-space:nowrap;
}

a{
    text-decoration:none;
    color:black;
}

/* Filter dropdown button hidden on desktop */
.filter-dropdown{
    display:none;
}

/* ================= MOBILE VIEW ================= */
@media(max-width:768px){

    /* Hide filters by default */
    #filters{
        display:none;
        flex-direction:column;
        align-items:flex-start;
        gap:1rem;
        background:white;
        padding:1rem;
        border-radius:1rem;
        box-shadow:0 4px 10px rgba(0,0,0,0.1);
        margin-top:1rem;
    }

    /* Show when active */
    #filters.show{
        display:flex;
    }

    /* Dropdown button show */
    .filter-dropdown{
        display:block;
        width:100%;
        margin-top:1rem;
    }

    .tax-toggle{
        width:100%;
        margin-left:0;
    }
}
</style>


<!-- Mobile Dropdown Button -->
<div class="dropdown filter-dropdown">
  <button class="btn btn-danger dropdown-toggle w-100" type="button"
          onclick="toggleFilters()">
    Filters
  </button>
</div>


<script>
function toggleFilters(){
   document.getElementById("filters").classList.toggle("show");
}
</script>
 <div id="filters">
      <div class="filter">
     <div> <a href="/listings?category=trend">  <i class="fa-solid fa-fire"></i></div>
     <p>  Trending </p>
     </a>
     </div>
      <div class="filter">
       <div><a href="/listings?category=rooms">   <i class="fa-solid fa-bed"></i></div>
       <p>  Rooms </p>
       </a>
    </div>
    <div class="filter">
     <div> <a href="/listings?category=iconicCity"> <i class="fa-solid fa-mountain-city"></i></div>
     <p>  Iconic Cities </p>
     </a>
     </div>
      <div class="filter">
       <div><a href="/listings?category=mountain"> <i class="fa-solid fa-mountain"></i></div>
       <p> Mountains </p>
       </a>
    </div>
    <div class="filter">
     <div><a href="/listings?category=castle">  <i class="fa-brands fa-fort-awesome"></i></div>
     <p>  castle</p>
     </a>
     </div>
      <div class="filter">
       <div><a href="/listings?category=amazingPools">  <i class="fa-solid fa-person-swimming"></i></div>
       <p>  Amazing Pools</p>
       </a>
    </div>
    <div class="filter">
       <div><a href="/listings?category=camping"><i class="fa-solid fa-campground"></i></div>
       <p> Camping </p>
    </a>
    </div>
    <div class="filter">
     <div><a href="/listings?category=farms"> <i class="fa-solid fa-cow"></i></div>
     <p>Farms</p>
     </a>
     </div>
      <div class="filter">
       <div><a href="/listings?category=arctic"> <i class="fa-regular fa-snowflake"></i></div>
       <p>  Arctic</p>
      </a>
    </div>
     <div class="filter">
     <div><a href="/listings?category=domes"><i class="fa-solid fa-igloo"></i></div>
     <p>Domes</p>
     </a>
     </div>
      <div class="filter">
       <div><a href="/listings?category=boats"><i class="fa-solid fa-sailboat"></i></div>
       <p> Boats</p>
       </a>
    </div>
    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display  total after Taxes </label>
</div>
 
    </div>


 </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-md-1 mt-3">
     <% for(let list of allList)  { %>
     <a href="/listings/<%= list._id %>" class="listing-link">
    <div class="card  col listing-card" style="width:20rem" >
      
  <img src="<%=list.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem" >
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
        <p>
    <b>   <%= list.title %> <br></b>
&#8377;<%= list.price ? list.price.toLocaleString("en-IN") : "0" %> /night        <i class="tax-info">  &nbsp; &nbsp;+18% GST</i> 
        </p>
    </p>
  </div>

</div>
</a>
        <% } %>
</div>

    
<script>
    let taxSwitch=document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", ()=>{
        let taxinfo=document.getElementsByClassName("tax-info");
        for(info of taxinfo){
            if(info.style.display !="inline"){
            info.style.display="inline";
        }else{
            info.style.display="none";
        }
    }
    })
</script>
